# Copy to .env for local development. Every variable is optional locally.

# PostgreSQL connection string. Without it the command log lives in memory.
# For Neon, use the direct (non-pooled) connection string, with its parameters:
#   postgresql://user:password@ep-name-id.region.aws.neon.tech/db?sslmode=require&channel_binding=require
# The engine holds a session-level advisory lock, which a transaction-mode
# pooler cannot keep. See DEPLOYMENT.md.
DATABASE_URL=postgres://marketlab:marketlab@localhost:5432/marketlab

# HMAC key for session tokens (32+ characters). Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Milliseconds between simulated market ticks.
TICK_MS=600

# Hours before a new trading session (fresh market) starts.
SESSION_HOURS=24

PORT=8080
LOG_LEVEL=info
