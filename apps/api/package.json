{
  "name": "@marketlab/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MarketLab API: engine host, command log, REST and server-sent events.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.js",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "bench:latency": "tsx src/bench/latency.ts",
    "bench:guests": "tsx --expose-gc src/bench/guests.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@marketlab/contracts": "*",
    "@marketlab/engine": "*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
