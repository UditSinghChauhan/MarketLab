# MarketLab Backend — Environment Variables
# Copy this file to .env and fill in the values.
# The server starts in memory-only mode when MONGO_URL is not set.

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign and verify JWT-style tokens (HMAC-SHA256).
# Generate a strong value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-random-64-char-hex-string

# ── Database (optional) ───────────────────────────────────────────────────────
# MongoDB connection string. Omit to run in in-memory mode (recommended for demos).
# MONGO_URL=mongodb://localhost:27017/marketlab

# ── Server ────────────────────────────────────────────────────────────────────
# HTTP port the API listens on. Dashboard proxy expects 3002.
PORT=3002
